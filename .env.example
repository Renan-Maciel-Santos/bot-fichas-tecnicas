# ============================================================
# CONFIGURAÇÃO DE AMBIENTE — PROJETO BOT FICHAS TÉCNICAS
# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env no Git.
#
# Este arquivo é escrito para uso a partir do HOST (scripts Python,
# psql, testes). Os containers do compose sobrescrevem o que precisam:
# a API, por exemplo, troca POSTGRES_HOST/PORT pelo endereço interno
# da rede do compose.
# ============================================================

# --- Postgres ---
# Porta 5433 no host: a 5432 já é usada por outro Postgres nesta
# máquina. Dentro da rede do compose o banco continua em 5432.
POSTGRES_DB=bot_fichas
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Perfil de MANUTENÇÃO (superuser): DDL, migrations, ingestão, extração.
# Usado só por scripts, nunca pela aplicação em runtime.
POSTGRES_USER=botuser
POSTGRES_PASSWORD=troque_essa_senha_local

# Perfil de APLICAÇÃO (least privilege): lê o acervo e escreve em
# `consultas`, `mensagens_processadas` e `contexto_conversa`. Sem DDL
# e sem DELETE no acervo. É com este que a API conecta.
# Criado por db/provisioning/001a_databases.sql.
BOT_APP_USER=bot_app
BOT_APP_PASSWORD=troque_essa_senha_local

# --- n8n ---
# Database dedicado, criado por db/provisioning/001a_databases.sql. O n8n
# não conecta mais como botuser no bot_fichas — ele despejava 48 tabelas
# dentro do database da aplicação, junto com documentos e produtos.
N8N_DB_NAME=n8n_bot
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=troque_essa_senha_local

# Cifra as credenciais gravadas no n8n. Se ficar vazia, o n8n autogera uma
# chave e a esconde dentro do volume: o container deixa de ser reproduzível
# e perder o volume significa perder todas as credenciais, sem recuperação.
# Gere UMA vez e guarde no cofre de senhas:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Trocar depois de haver credencial cadastrada inutiliza todas elas.
N8N_ENCRYPTION_KEY=

# REMOVIDAS: N8N_USER e N8N_PASSWORD alimentavam N8N_BASIC_AUTH_*, que são
# inoperantes desde o n8n v1 — estavam configuradas e não protegiam nada.
# A autenticação é conta de owner gravada no database, criada na primeira
# vez que se abre a interface.

# --- API HTTP do bot ---
# Chave pré-compartilhada com o n8n (header X-API-Key). Sem valor padrão
# no código: ausência de configuração FECHA a API (503), não libera.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Validade da pendência de desambiguação de produto, em minutos. É por
# este prazo que a resposta "2" a um "qual deles? 1... 2... 3..." ainda
# é entendida como escolha. Ver src/query/contexto.py.
CONTEXTO_TTL_MINUTOS=15

# --- LLM APIs ---
# Todo o motor usa OpenAI hoje: embeddings, classificação de intenção,
# extração estruturada e redação das respostas (src/openai_client.py).
# Não há chamada à Anthropic no código — o README antigo dizia Claude
# Haiku, mas isso nunca chegou a ser implementado.
OPENAI_API_KEY=

# Prazo, em segundos, de cada chamada à OpenAI. Vazio aqui = padrão do
# SDK (10 min), que é o que os scripts de lote rodados do host precisam.
# O container da API usa 30 quando esta variável está vazia
# (docker-compose.yml); preencha só para mudar o prazo da API.
OPENAI_TIMEOUT_SEGUNDOS=

# --- Google Drive (ingestão) ---
# ID da pasta-raiz "Ficha Técnica / FDS / Laudos" no Drive do cliente.
GOOGLE_DRIVE_FOLDER_ID=

# Caminho local para o JSON da service account do Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json

# Confiança mínima do classificador para gravar `documentos.tipo`.
# Abaixo disso o tipo fica NULL e o documento cai na v_pendentes_revisao.
CONFIANCA_MINIMA_TIPO=0.7

# Conjunto de heurísticas de domínio na ingestão: "reseller_a" ou "none".
# Ver src/heuristics_registry.py.
INGEST_HEURISTICAS=reseller_a

# --- WhatsApp / Evolution API ---
# A Evolution do bot sobe pelo docker-compose deste projeto, com
# database e volume próprios. Porta 8081 no host porque a 8080 costuma
# estar ocupada por outra Evolution nesta máquina; dentro da rede do
# compose ela atende em 8080 (http://evolution:8080).
EVOLUTION_PORT=8081
EVOLUTION_API_URL=http://localhost:8081

# Chave ADMIN da Evolution: cria, lista e APAGA instâncias. Usada só
# para criar a instância e entrar no manager.
#     python -c "import secrets; print(secrets.token_hex(32))"
EVOLUTION_GLOBAL_KEY=

# Token da instância `bot_fichas`, com escopo de uma instância só.
# É esta que o n8n usa para enviar mensagem — nunca a global.
# Preenchida automaticamente por `python -m scripts.setup_whatsapp
# --aplicar`, que a lê do banco depois que a instância existir.
EVOLUTION_INSTANCE_NAME=bot_fichas
EVOLUTION_API_KEY=

# Database dedicado da Evolution, criado por db/provisioning/001a.
EVOLUTION_DB_NAME=evolution_bot
EVOLUTION_DB_USER=evolution_user
EVOLUTION_DB_PASSWORD=troque_essa_senha_local

# --- Configurações da aplicação ---
LOG_LEVEL=INFO
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL_EXTRACTION=gpt-4o-mini
LLM_MODEL_RESPONSE=gpt-4o-mini
